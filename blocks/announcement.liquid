<div
  class="announcement-bar__item"
  {{ block.shopify_attributes }}
>
  {% if block.settings.link != blank %}
    <a
      href="{{ block.settings.link }}"
      class="announcement-bar__text"
    >
      {{ block.settings.text | escape }}
    </a>
  {% else %}
    <span class="announcement-bar__text">
      {{ block.settings.text | escape }}
    </span>
  {% endif %}
</div>

{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "100% CLEAN, NON-IRRITATING"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}